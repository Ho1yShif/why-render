{
  "name": "fde-render-explainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unofficial explainer: why OpenAI forward-deployed engineers should ship customer apps and agents on Render.",
  "scripts": {
    "dev": "npm run build && concurrently \"vite build --watch\" \"tsx watch --include dist/index.html src/server/index.ts\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist-server/server/migrate.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-html-parser": "^9.0.4",
    "pg": "^8.23.1"
  }
}
